# Copy to .env. Never commit the real file. Provider secrets are passed only
# to the Hermes controller, never to the model-facing command sandbox.
#
# Preferred setup: leave these overrides empty and run `./hermesctl model`.
# The official wizard persists the selected provider/model in isolated state.
HERMES_NAKED_PROVIDER=
HERMES_NAKED_MODEL=

# Optional explicit overrides (usually unnecessary):
# LM Studio in the host desktop app:
# LM_BASE_URL=http://host.docker.internal:1234/v1
# LM_API_KEY=
#
# Ollama on the host (Hermes provider: Custom endpoint):
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=
#
# Native Anthropic API-key authentication (not the monthly Claude plan):
# ANTHROPIC_API_KEY=

# Optional image overrides. Pin tags/digests for reproducible deployments.
HERMES_IMAGE=nousresearch/hermes-agent@sha256:cbcbe555961c3f36124db521a179b5b61eea00acf5629a27086c9350899df191
HERMES_SANDBOX_IMAGE=python:3.13-slim-bookworm

# Independently pinned coding-worker images and CLI versions.
WORKER_NODE_IMAGE=node:22.18.0-bookworm-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e
CODEX_CLI_VERSION=0.146.0
CLAUDE_CLI_VERSION=2.1.220
OPENCODE_CLI_VERSION=1.18.11
