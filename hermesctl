}

raw_capabilities() {
  if [[ -f "$CAPABILITIES_FILE" ]]; then
    tr '\n' ',' < "$CAPABILITIES_FILE"
  fi
}

policy_json() {
  local raw=${1-$(raw_capabilities)}
  python3 - "$raw" "$POLICY_MODULE_DIR" "$POLICY_MODULE_NAME" <<'PY'
import importlib
import json
import sys
sys.path.insert(0, sys.argv[2])
policy_module = importlib.import_module(sys.argv[3])
PolicyError = policy_module.PolicyError
parse_capabilities = policy_module.parse_capabilities

try:
    policy = parse_capabilities(sys.argv[1])
except PolicyError as exc:
    print(f"hermesctl: {exc}", file=sys.stderr)
    raise SystemExit(64)

print(json.dumps({
    "capabilities": policy.capabilities,
    "toolsets": policy.toolsets,
    "needs_sandbox": policy.needs_sandbox,
    "sandbox_network": policy.sandbox_network,
    "mount_skills": policy.mount_skills,
    "mount_control": policy.mount_control,
      "direct_control": policy.direct_control,
      "mcp_control": "hermesctl-mcp" in policy.capabilities,
      "enable_mcp": policy.enable_mcp,
    "load_orchestrator": policy.load_orchestrator,
    "load_claude_context": policy.load_claude_context,
    "load_context_files": policy.load_context_files,
    "direct_workers": policy.direct_workers,
    "mcp_workers": policy.mcp_workers,
    "workers": policy.workers,
    "generic_agents_direct": policy.generic_agents_direct,
    "generic_agents_mcp": policy.generic_agents_mcp,
}))
PY
}

policy_field() {
  local field=$1
  local json=$2
  python3 - "$field" "$json" <<'PY'
import json
import sys
value = json.loads(sys.argv[2])[sys.argv[1]]
if isinstance(value, bool):
    print("true" if value else "false")
elif isinstance(value, list):
    print(",".join(value))
else:
    print(value)
PY
}

write_capabilities() {
  local action=$1
  shift
  (($# > 0)) || die "$action needs at least one capability"
  local current
  current=$(raw_capabilities)
  local normalized
  normalized=$(python3 - "$action" "$current" "$POLICY_MODULE_DIR" "$POLICY_MODULE_NAME" "$@" <<'PY'
import importlib
import sys
sys.path.insert(0, sys.argv[3])
policy_module = importlib.import_module(sys.argv[4])
PolicyError = policy_module.PolicyError
normalize_capability = policy_module.normalize_capability
parse_capabilities = policy_module.parse_capabilities

action, current = sys.argv[1:3]
requested = sys.argv[5:]
current_values = set(parse_capabilities(current).capabilities)
requested_values = {normalize_capability(value) for value in requested}
if action == "enable":
    result = current_values | requested_values
else:
    result = current_values - requested_values
try:
    policy = parse_capabilities(",".join(sorted(result)))
except PolicyError as exc:
    print(f"hermesctl: {exc}", file=sys.stderr)
    raise SystemExit(64)
print("\n".join(policy.capabilities))
PY
  )
  commit_capabilities "$normalized"
}

commit_capabilities() {
  local content=${1-}
  if [[ "$CONTROL_ONLY" == 1 ]]; then
    # A bind-mounted file cannot be atomically replaced inside a container.
    # Lock and rewrite that exact inode instead.
    python3 - "$CAPABILITIES_FILE" "$content" <<'PY'
import fcntl
import os
import sys

path, content = sys.argv[1:]
with open(path, "r+", encoding="utf-8") as handle:
    fcntl.flock(handle, fcntl.LOCK_EX)
    handle.seek(0)
    handle.truncate()
    if content:
        handle.write(content + "\n")
    handle.flush()
    os.fsync(handle.fileno())
    fcntl.flock(handle, fcntl.LOCK_UN)
PY
    return
  fi

  local temporary
  temporary=$(mktemp "$RUNTIME_DIR/.capabilities.XXXXXX")
  if [[ -n "$content" ]]; then
    printf '%s\n' "$content" > "$temporary"
  fi
  chmod 600 "$temporary"
  mv "$temporary" "$CAPABILITIES_FILE"
}

compose_for_policy() {
  local json=$1
  if [[ $(policy_field needs_sandbox "$json") == true ]]; then
    [[ -S /var/run/docker.sock ]] || die 'Docker socket is required for files/commandline/code'
    printf '%s\0' "${BASE_COMPOSE[@]}" "${SANDBOX_COMPOSE[@]}"
  else
    printf '%s\0' "${BASE_COMPOSE[@]}"
  fi
  if [[ $(policy_field mount_control "$json") == true ]]; then
    printf '%s\0' "${CONTROL_COMPOSE[@]}"
  fi
  if [[ $(policy_field load_orchestrator "$json") == true ]]; then
    printf '%s\0' "${ORCHESTRATOR_COMPOSE[@]}"
  fi
  if [[ $(policy_field load_claude_context "$json") == true ]]; then
    printf '%s\0' "${CLAUDE_CONTEXT_COMPOSE[@]}"
  fi
  if [[ $(policy_field generic_agents_direct "$json") == true ]] || \
     [[ $(policy_field generic_agents_mcp "$json") == true ]]; then
    printf '%s\0' "${AGENTS_COMPOSE[@]}"
  fi
  local workers worker
  workers=$(policy_field workers "$json")
  if [[ -n "$workers" ]]; then
    while IFS= read -r worker; do
      [[ -n "$worker" ]] || continue
      printf '%s\0' -f "$ROOT_DIR/compose.worker-$worker.yaml"
    done < <(tr ',' '\n' <<< "$workers")
  fi
}

run_container() {
  local raw json
  raw=$(raw_capabilities)
  json=$(policy_json "$raw")
  local -a compose_command=()
  while IFS= read -r -d '' item; do
    compose_command+=("$item")
  done < <(compose_for_policy "$json")
  HERMES_CAPABILITIES="$raw" "${compose_command[@]}" run --rm \
    -e "HERMES_CAPABILITIES=$raw" hermes "$@"
}

run_admin() {
  # Administrative commands are explicit operator actions. They do not need
  # the model policy or Docker socket and therefore always use the base file.
  HERMES_CAPABILITIES='' "${BASE_COMPOSE[@]}" run --rm \
    -e HERMES_CAPABILITIES= hermes hermes "$@"
}

normalize_worker() {
  local worker=${1:-}
  case "$worker" in
    codex|claude|opencode) printf '%s\n' "$worker" ;;
    *) die "unknown worker: ${worker:-missing} (expected codex, claude, or opencode)" ;;
  esac
}

normalize_access_target() {
  local target=${1:-}
  target=${target,,}
  target=${target//_/-}
  case "$target" in
    hermes) printf 'hermes\n' ;;
    codex|codex-cli) printf 'codex\n' ;;
    claude|claude-cli|claude-code) printf 'claude\n' ;;
    opencode|opencode-cli|open-code) printf 'opencode\n' ;;
    *)
      die "unknown access target: ${target:-missing} "\
        '(expected hermes, codex, claude, or opencode)'
      ;;
  esac
}

map_access_features() {
  local target=$1
  shift
  (($# > 0)) || die 'access enable/disable needs at least one feature'
  ACCESS_MAPPED_FEATURES=()
  local requested generic mapped
  for requested in "$@"; do
    generic=${requested,,}
    generic=${generic//_/-}
    case "$generic" in
      tool|tools|tool-use|tooluse) generic=tool-use ;;
      commandline|shell|terminal) generic=commandline ;;
      skill|skills) generic=skills ;;
      agents|agents-md|agents.md|agentsmd) generic=agents-md ;;
      claude-md|claude.md|claudemd) generic=claude-md ;;
      *) die "unknown generic access feature: $requested" ;;
    esac
    if [[ "$target" == hermes ]]; then
      case "$generic" in
        tool-use) mapped=files ;;
        agents-md) mapped=orchestrator ;;
        *) mapped=$generic ;;
      esac
    else
      case "$generic" in
        tool-use) mapped=tools ;;
        *) mapped=$generic ;;
      esac
    fi
    ACCESS_MAPPED_FEATURES+=("$mapped")
  done
}

show_access_capabilities() {
  cat <<'EOF'
Common access features:
  tool-use      target's narrow file/read/search/edit tool level
  commandline   target's command execution/write level
  skills        reviewed skill instructions or policy-gated skill tools
  agents-md     protected AGENTS.md orchestration context
  claude-md     protected CLAUDE.md compatibility context

Aliases: tools=tool-use, shell/terminal=commandline,
         AGENTS.md=agents-md, CLAUDE.md=claude-md
EOF
}

show_access_explanation() {
  local target=$1
  printf 'Access target: %s\n' "$target"
  case "$target" in
    hermes)
      cat <<'EOF'
[native]     tool-use    -> Hermes files (isolated Hermes workspace only)
[native]     commandline -> netless nested command sandbox
[native]     skills      -> policy-gated Hermes skill tools
[controlled] agents-md   -> protected root AGENTS.md (underlying: orchestrator)
[controlled] claude-md   -> protected root CLAUDE.md
[alternative] Advanced Hermes-only switches remain available through
              `hermesctl capabilities` and `hermesctl enable|disable`.
EOF
      ;;
    codex)
      cat <<'EOF'
[special]    tool-use    -> Codex shell tool in a read-only sandbox
[special]    commandline -> the same shell path with workspace-write;
                            requires tool-use in this policy
[controlled] skills      -> reviewed SKILL.md bodies are injected; native
                            dynamic skill discovery stays disabled
[controlled] agents-md   -> protected worker AGENTS.md
[controlled] claude-md   -> protected worker CLAUDE.md
[alternative] For no command execution, leave tool-use off (model-only).
              For inspection, enable tool-use alone. For a true native split
              between file tools and Bash, use the Claude or OpenCode worker.
EOF
      ;;
    claude)
      cat <<'EOF'
[native]     tool-use    -> Read, Glob, Grep, Edit, Write; Bash stays disabled
[native]     commandline -> adds Bash and requires tool-use in this policy
[controlled] skills      -> reviewed SKILL.md bodies are injected; native
                            dynamic skill discovery stays disabled
[controlled] agents-md   -> protected worker AGENTS.md
[controlled] claude-md   -> protected worker CLAUDE.md
[alternative] Use tool-use without commandline for native file tools only.
              Add reviewed skills under worker-context/claude/skills.
EOF
      ;;
    opencode)
      cat <<'EOF'
[native]     tool-use    -> read, glob, grep, edit; Bash stays denied
[native]     commandline -> additionally allows Bash and requires tool-use
[controlled] skills      -> reviewed SKILL.md bodies are injected; native
                            dynamic skill discovery stays denied
[controlled] agents-md   -> protected worker AGENTS.md
[controlled] claude-md   -> protected worker CLAUDE.md
[alternative] Use tool-use without commandline for native file permissions.
              Add reviewed skills under worker-context/opencode/skills.
EOF
      ;;
  esac
}

show_access_status() {
  local target=$1
  local json enabled_text
  local -a enabled=()
  printf 'Access target:     %s\n' "$target"
  if [[ "$target" == hermes ]]; then
    json=$(policy_json)
    enabled_text=",$(policy_field capabilities "$json"),"
    [[ "$enabled_text" == *,files,* ]] && enabled+=(tool-use)
    [[ "$enabled_text" == *,commandline,* ]] && enabled+=(commandline)
    [[ "$enabled_text" == *,skills,* ]] && enabled+=(skills)
    [[ "$enabled_text" == *,orchestrator,* ]] && enabled+=(agents-md)
    [[ "$enabled_text" == *,claude-md,* ]] && enabled+=(claude-md)
    printf 'Common access:     %s\n' "${enabled[*]:-none (pure chat)}"
    show_status
  else
    json=$(worker_policy_json "$target")
    [[ $(policy_field tools "$json") == true ]] && enabled+=(tool-use)
    [[ $(policy_field commandline "$json") == true ]] && enabled+=(commandline)
    [[ $(policy_field skills "$json") == true ]] && enabled+=(skills)
    [[ $(policy_field agents_md "$json") == true ]] && enabled+=(agents-md)
    [[ $(policy_field claude_md "$json") == true ]] && enabled+=(claude-md)
    printf 'Common access:     %s\n' "${enabled[*]:-none (model-only)}"
    show_worker_rights "$target"
  fi
  case "$target" in
    codex)
      printf 'Adapter:           [special] Codex has no native file/shell split\n'
      ;;
    hermes)
      printf 'Adapter:           [native] Hermes capability policy\n'
      ;;
    *)
      printf 'Adapter:           [native] separate file and command surfaces\n'
      ;;
  esac
  printf 'Mapping details:   hermesctl access %s explain\n' "$target"
}

access_command() {
  local target
  target=$(normalize_access_target "${1:-}")
  shift || true
  local action=${1:-status}
  if (($# > 0)); then
    shift
  fi

  case "$action" in
    status|rights)
      (($# == 0)) || die 'access status accepts no additional arguments'
      show_access_status "$target"
      ;;
    explain)
      (($# == 0)) || die 'access explain accepts no additional arguments'
      show_access_explanation "$target"
      ;;
    capabilities)
      (($# == 0)) || die 'access capabilities accepts no additional arguments'
      show_access_capabilities
      printf '\n'
      show_access_explanation "$target"
      ;;
    enable|disable)
      map_access_features "$target" "$@"
      if [[ "$target" == hermes ]]; then
        write_capabilities "$action" "${ACCESS_MAPPED_FEATURES[@]}"
      else
        write_worker_features "$target" "$action" "${ACCESS_MAPPED_FEATURES[@]}"
      fi
      show_access_status "$target"
      ;;
    reset)
      (($# == 0)) || die 'access reset accepts no additional arguments'
      if [[ "$target" == hermes ]]; then
        commit_capabilities ''
      else
        commit_worker_features "$target" ''
      fi
      show_access_status "$target"
      ;;
    *) die "unknown access action: $action" ;;
  esac
}

worker_compose() {
  local worker=$1
  printf '%s\0' "${BASE_COMPOSE[@]}" -f "$ROOT_DIR/compose.worker-$worker.yaml"
}

worker_command() {
  local worker
  worker=$(normalize_worker "${1:-}")
  shift || true
  local action=${1:-status}
  if (($# > 0)); then
    shift
  fi

  case "$action" in
    rights)
      (($# == 0)) || die 'worker rights accepts no additional arguments'
      show_worker_rights "$worker"
      return
      ;;
    capabilities)
      (($# == 0)) || die 'worker capabilities accepts no additional arguments'
      show_worker_capabilities
      return
      ;;
    enable|disable)
      write_worker_features "$worker" "$action" "$@"
      show_worker_rights "$worker"
      return
      ;;
    reset)
      (($# == 0)) || die 'worker reset accepts no additional arguments'
      commit_worker_features "$worker" ''
      show_worker_rights "$worker"
      return
      ;;
  esac

  if [[ "$CONTROL_ONLY" == 1 ]]; then
    die "worker action is unavailable through model-facing hermesctl: $action"
  fi

  local service="worker-$worker"
  local -a compose_command=()
  while IFS= read -r -d '' item; do
    compose_command+=("$item")
  done < <(worker_compose "$worker")

  case "$action" in
    build)
      "${compose_command[@]}" build "$service"
      ;;
    login)
      case "$worker" in
        codex)
          if (($# == 0)); then
            "${compose_command[@]}" run --rm --entrypoint codex \
              "$service" -c 'cli_auth_credentials_store="file"' \
              login --device-auth
          else
            "${compose_command[@]}" run --rm --entrypoint codex \
              "$service" -c 'cli_auth_credentials_store="file"' \
              login "$@"
          fi
          ;;
        claude)
          "${compose_command[@]}" run --rm --entrypoint claude \
            "$service" auth login "$@"
          ;;
        opencode)
          "${compose_command[@]}" run --rm --entrypoint opencode \
            "$service" auth login "$@"
          ;;
      esac
      ;;
    logout)
      case "$worker" in
        codex)
          "${compose_command[@]}" run --rm --entrypoint codex \
            "$service" logout "$@"
          ;;
        claude)
          "${compose_command[@]}" run --rm --entrypoint claude \
            "$service" auth logout "$@"
          ;;
        opencode)
          "${compose_command[@]}" run --rm --entrypoint opencode \
            "$service" auth logout "$@"
          ;;
      esac
      ;;
    status)
      local model_file="$RUNTIME_DIR/workers/$worker/state/.worker-model"
      local model=default
      if [[ -s "$model_file" ]]; then
        model=$(<"$model_file")
      fi
      printf 'Worker: %s\nModel:  %s\nState:  %s\nWorkspace: %s\n' \
        "$worker" "$model" \
        "$RUNTIME_DIR/workers/$worker/state" \
        "$RUNTIME_DIR/workers/$worker/workspace"
      show_worker_rights "$worker"
      set +e
      case "$worker" in
        codex)
          "${compose_command[@]}" run --rm --entrypoint codex \
            "$service" login status
          ;;
        claude)
          "${compose_command[@]}" run --rm --entrypoint claude \
            "$service" auth status --text
          ;;
        opencode)
          "${compose_command[@]}" run --rm --entrypoint opencode \
            "$service" auth list
          ;;
      esac
      local status_code=$?
      set -e
      printf 'Auth status exit code: %s\n' "$status_code"
      ;;
    model)
      local model_file="$RUNTIME_DIR/workers/$worker/state/.worker-model"
      if (($# == 0)); then
        if [[ -s "$model_file" ]]; then
          printf '%s\n' "$(<"$model_file")"
        else
          printf 'default\n'
        fi
        return
      fi
      (($# == 1)) || die 'worker model accepts exactly one model id or none'
      if [[ "$1" == none ]]; then
        : > "$model_file"
        chmod 600 "$model_file"
        printf 'Cleared %s worker model; CLI default will be used.\n' "$worker"
        return
      fi
      [[ "$1" =~ ^[A-Za-z0-9_.:/@+-]+$ ]] || die 'model id contains unsupported characters'
      local temporary
      temporary=$(mktemp "$RUNTIME_DIR/workers/$worker/state/.worker-model.XXXXXX")
      printf '%s\n' "$1" > "$temporary"
      chmod 600 "$temporary"
      mv "$temporary" "$model_file"
      printf 'Configured %s worker model: %s\n' "$worker" "$1"
      ;;
    start)
      "${compose_command[@]}" up -d --wait --wait-timeout 60 "$service"
      ;;
    stop)
      "${compose_command[@]}" stop "$service"
      ;;
    run)
      (($# > 0)) || die 'worker run needs a prompt'
      "${compose_command[@]}" up -d --wait --wait-timeout 60 "$service"
      local socket_variable="HERMES_${worker^^}_WORKER_SOCKET"
      local socket_path="$RUNTIME_DIR/workers/$worker/socket/worker.sock"
      env PYTHONPATH="$ROOT_DIR/container" "$socket_variable=$socket_path" \
        python3 "$ROOT_DIR/container/workerctl.py" "$worker" run "$*"
      ;;
    *)
      die "unknown worker action: $action"
      ;;
  esac
}

show_status() {
  local json caps toolsets
  json=$(policy_json)
  caps=$(policy_field capabilities "$json")
  toolsets=$(policy_field toolsets "$json")
  printf 'Capabilities:      %s\n' "${caps:-none (pure chat)}"
  printf 'Hermes toolsets:   %s\n' "${toolsets:-none}"
  if [[ $(policy_field load_orchestrator "$json") == true ]] && \
     [[ $(policy_field load_claude_context "$json") == true ]]; then
    printf 'Context files:     protected AGENTS.md and CLAUDE.md loaded (opt-in)\n'
  elif [[ $(policy_field load_orchestrator "$json") == true ]]; then
    printf 'Context files:     protected AGENTS.md loaded (opt-in)\n'
  elif [[ $(policy_field load_claude_context "$json") == true ]]; then
    printf 'Context files:     protected CLAUDE.md loaded (opt-in)\n'
  else
    printf 'Context files:     ignored (AGENTS.md, SOUL.md, .hermes.md, CLAUDE.md)\n'
  fi
  printf 'Memory:            disabled and not injected\n'
  printf 'Bundled skills:    disabled; project skills installed but policy-gated\n'
  printf 'Plugins:           disabled\n'
  printf 'Hermesctl MCP:     %s\n' "$(policy_field mcp_control "$json")"
  printf 'Hermesctl direct:  %s\n' "$(policy_field direct_control "$json")"
  printf 'Worker direct:     %s\n' "$(policy_field direct_workers "$json" | sed 's/^$/none/')"
  printf 'Worker MCP:        %s\n' "$(policy_field mcp_workers "$json" | sed 's/^$/none/')"
  printf 'Agents direct:     %s\n' "$(policy_field generic_agents_direct "$json")"
  printf 'Agents MCP:        %s\n' "$(policy_field generic_agents_mcp "$json")"
  printf 'Command sandbox:  %s\n' "$(policy_field needs_sandbox "$json")"
  printf 'Sandbox network:  %s\n' "$(policy_field sandbox_network "$json")"
  printf 'Workspace:         %s\n' "$WORKSPACE_DIR"
}

command=${1:-help}
if (($# > 0)); then
  shift
fi

if [[ "$CONTROL_ONLY" == 1 ]]; then
  case "$command" in
    access|enable|disable|reset|status|capabilities|worker|agent|help|-h|--help) ;;
    *) die "command is unavailable through model-facing hermesctl: $command" ;;
  esac
fi

case "$command" in
  init)
    ensure_layout
    printf 'Initialized with zero model-facing capabilities.\n'
    show_status
    ;;
  build)
    ensure_layout
    "${BASE_COMPOSE[@]}" build --pull hermes
    ;;
  enable)
    ensure_layout
    write_capabilities enable "$@"
    show_status
    ;;
  disable)
    ensure_layout
    write_capabilities disable "$@"
    show_status
    ;;
  reset)
    ensure_layout
    commit_capabilities ''
    show_status
    ;;
  status)
    ensure_layout
    show_status
    ;;
  capabilities)
    usage | sed -n '/^Capabilities:/,$p'
    ;;
  chat)
    ensure_layout
    run_container hermes-naked chat "$@"
    ;;
  ask)
    ensure_layout
    (($# > 0)) || die 'ask needs a prompt'
    run_container hermes-naked chat --query "$*"
    ;;
  auth)
    ensure_layout
    run_admin auth "$@"
    ;;
  model)
    ensure_layout
    run_admin model "$@"
    ;;
  anthropic-login)
    ensure_layout
    cat >&2 <<'EOF'
Anthropic-Hinweis: Hermes kann das reguläre Claude-Pro-Kontingent nicht nutzen.
Hermes dokumentiert OAuth derzeit nur für Claude Max mit zusätzlich gekauften
Extra-Usage-Credits; Anfragen werden diesen Zusatz-Credits berechnet.
EOF
    run_admin auth add anthropic "$@" --type oauth
    ;;
  login-ui)
    ensure_layout
    exec python3 "$ROOT_DIR/container/login_ui.py" --root "$ROOT_DIR" "$@"
    ;;
  skills)
    ensure_layout
    run_admin skills "$@"
    ;;
  worker)
    ensure_layout
    worker_command "$@"
    ;;
  agent)
    ensure_layout
    if [[ "$CONTROL_ONLY" == 1 ]]; then
      case "${1:-}" in
        list|rights|explain|grant|revoke|reset) ;;
        *) die "agent action is unavailable through model-facing hermesctl: ${1:-missing}" ;;
      esac
    fi
    [[ -f "$CONTROL_CLI" ]] || die 'control-plane CLI is unavailable'
    python3 "$CONTROL_CLI" --root "$ROOT_DIR" "$command" "$@"
    ;;
  credential|team|job|artifact|benchmark)
    ensure_layout
    [[ "$CONTROL_ONLY" == 0 ]] || die "$command is unavailable through model-facing hermesctl"
    [[ -f "$CONTROL_CLI" ]] || die 'control-plane CLI is unavailable'
    python3 "$CONTROL_CLI" --root "$ROOT_DIR" "$command" "$@"
    ;;
  access)
    ensure_layout
    access_command "$@"
    ;;
  verify)
    ensure_layout
    verify_raw_before=$(raw_capabilities)
    verify_worker_raw_before=''
    for verify_worker in "${WORKER_KINDS[@]}"; do
      verify_worker_raw_before+="$verify_worker:$(raw_worker_features "$verify_worker");"
    done
    python3 -m unittest discover -s "$ROOT_DIR/tests" -v
    "${BASE_COMPOSE[@]}" config --quiet
    "${BASE_COMPOSE[@]}" "${ORCHESTRATOR_COMPOSE[@]}" \
      "${CLAUDE_CONTEXT_COMPOSE[@]}" config --quiet
    "${BASE_COMPOSE[@]}" "${ALL_WORKER_COMPOSE[@]}" config --quiet
    env \
      AGENT_ID=verify-agent \
      AGENT_ENGINE=claude \
      AGENT_CLI_VERSION="${CLAUDE_CLI_VERSION:-2.1.220}" \
      AGENT_STATE="$RUNTIME_DIR/agents/verify-agent/state" \
      AGENT_WORKSPACE="$RUNTIME_DIR/agents/verify-agent/workspace" \
      AGENT_CONTEXT="$ROOT_DIR/worker-context/claude" \
      AGENT_SOCKET="$RUNTIME_DIR/sockets/agents/verify-agent" \
      AGENT_CONTROL="$RUNTIME_DIR/control/agents/verify-agent" \
      AGENT_CREDENTIAL_HOME="$RUNTIME_DIR/credentials/verify-agent/home" \
      docker compose --project-directory "$ROOT_DIR" \
      -f "$ROOT_DIR/compose.agent.yaml" config --quiet
    "${BASE_COMPOSE[@]}" "${AGENTS_COMPOSE[@]}" config --quiet
    "${BASE_COMPOSE[@]}" build hermes
    "${BASE_COMPOSE[@]}" "${ALL_WORKER_COMPOSE[@]}" build \
      worker-codex worker-claude worker-opencode
    printf '\nPython runtime probes:\n'
    verify_python_images=(
      hermes-naked:local
      hermes-worker-codex:local
      hermes-worker-claude:local
      hermes-worker-opencode:local
      "${HERMES_SANDBOX_IMAGE:-python:3.13-slim-bookworm}"
    )
    for verify_python_image in "${verify_python_images[@]}"; do
      printf '%s\n' "$verify_python_image"
      docker run --rm --entrypoint /bin/sh "$verify_python_image" -c \
        'python --version && python3 --version && pip3 --version && python3 -c "import venv"'
    done
    env COMPOSE_IGNORE_ORPHANS=true \
      "${BASE_COMPOSE[@]}" "${ALL_WORKER_COMPOSE[@]}" up -d --wait \
      --wait-timeout 60 worker-codex worker-claude worker-opencode
    printf '\nBaseline policy report (forced empty):\n'
    HERMES_CAPABILITIES='' "${BASE_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES= hermes hermes-naked --policy-report
    printf '\nConfigured policy report:\n'
    run_container hermes-naked --policy-report
    printf '\nAir-gapped command-sandbox probe (temporary files capability):\n'
    HERMES_CAPABILITIES='files' "${BASE_COMPOSE[@]}" "${SANDBOX_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES=files hermes hermes-naked --sandbox-probe
    printf '\nDirect hermesctl sandbox probe (temporary policy):\n'
    HERMES_CAPABILITIES='commandline,skills,hermesctl-direct' \
      "${BASE_COMPOSE[@]}" "${SANDBOX_COMPOSE[@]}" "${CONTROL_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES=commandline,skills,hermesctl-direct \
      hermes hermes-naked --sandbox-probe
    printf '\nScoped hermesctl MCP probe (temporary policy):\n'
    HERMES_CAPABILITIES='skills,hermesctl-mcp' \
      "${BASE_COMPOSE[@]}" "${CONTROL_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES=skills,hermesctl-mcp \
      hermes hermes-naked --mcp-probe
    printf '\nDirect coding-worker sandbox probe (temporary policy):\n'
    HERMES_CAPABILITIES='commandline,skills,codex-direct,claude-direct,opencode-direct' \
      "${BASE_COMPOSE[@]}" "${SANDBOX_COMPOSE[@]}" \
      "${ALL_WORKER_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES=commandline,skills,codex-direct,claude-direct,opencode-direct \
      hermes hermes-naked --sandbox-probe
    printf '\nScoped coding-worker MCP probe (temporary policy):\n'
    HERMES_CAPABILITIES='skills,codex-mcp,claude-mcp,opencode-mcp' \
      "${BASE_COMPOSE[@]}" "${ALL_WORKER_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES=skills,codex-mcp,claude-mcp,opencode-mcp \
      hermes hermes-naked --mcp-probe
    printf '\nGeneric registered-agent direct probe (temporary policy):\n'
    HERMES_CAPABILITIES='commandline,skills,agents-direct' \
      "${BASE_COMPOSE[@]}" "${SANDBOX_COMPOSE[@]}" \
      "${AGENTS_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES=commandline,skills,agents-direct \
      hermes hermes-naked --sandbox-probe
    printf '\nGeneric agents/jobs/artifacts/teams MCP probe (temporary policy):\n'
    HERMES_CAPABILITIES='skills,agents-mcp' \
      "${BASE_COMPOSE[@]}" "${AGENTS_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES=skills,agents-mcp \
      hermes hermes-naked --mcp-probe
    printf '\nAGENTS.md orchestrator probe (temporary policy):\n'
    HERMES_CAPABILITIES='orchestrator' \
      "${BASE_COMPOSE[@]}" "${ORCHESTRATOR_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES=orchestrator \
      hermes hermes-naked --context-probe
    printf '\nIndependent CLAUDE.md context probe (temporary policy):\n'
    HERMES_CAPABILITIES='claude-md' \
      "${BASE_COMPOSE[@]}" "${CLAUDE_CONTEXT_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES=claude-md \
      hermes hermes-naked --context-probe
    printf '\nCombined AGENTS.md + CLAUDE.md context probe (temporary policy):\n'
    HERMES_CAPABILITIES='orchestrator,claude-md' \
      "${BASE_COMPOSE[@]}" "${ORCHESTRATOR_COMPOSE[@]}" \
      "${CLAUDE_CONTEXT_COMPOSE[@]}" run --rm \
      -e HERMES_CAPABILITIES=orchestrator,claude-md \
      hermes hermes-naked --context-probe
    [[ $(raw_capabilities) == "$verify_raw_before" ]] || \
      die 'verify unexpectedly changed the configured capabilities'
    verify_worker_raw_after=''
    for verify_worker in "${WORKER_KINDS[@]}"; do
      verify_worker_raw_after+="$verify_worker:$(raw_worker_features "$verify_worker");"
    done
    [[ "$verify_worker_raw_after" == "$verify_worker_raw_before" ]] || \
      die 'verify unexpectedly changed a worker profile'
    printf '\nConfigured Hermes capabilities and worker profiles remained unchanged.\n'
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    die "unknown command: $command"
    ;;
esac
