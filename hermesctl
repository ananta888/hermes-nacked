#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
ROOT_DIR=${HERMESCTL_ROOT:-$SCRIPT_DIR}
RUNTIME_DIR="$ROOT_DIR/runtime"
STATE_DIR="$RUNTIME_DIR/state"
WORKSPACE_DIR="$RUNTIME_DIR/workspace"
CAPABILITIES_FILE=${HERMESCTL_CAPABILITIES_FILE:-$ROOT_DIR/.hermes-capabilities}
POLICY_MODULE_DIR=${HERMESCTL_POLICY_DIR:-$ROOT_DIR/container}
POLICY_MODULE_NAME=policy
PROJECT_SKILLS_DIR="$ROOT_DIR/skills"
CONTROL_CLI="$ROOT_DIR/container/control_cli.py"
WORKER_CONTROL_DIR=${HERMESCTL_WORKER_CONTROL_DIR:-$RUNTIME_DIR/control/workers}
CONTROL_ONLY=${HERMESCTL_CONTROL_ONLY:-0}
WORKER_POLICY_MODULE_NAME=worker_policy
if [[ "$CONTROL_ONLY" == 1 ]]; then
  # Both the controller MCP process and the nested direct-control sandbox
  # receive the policy module at this fixed, read-only path.
  POLICY_MODULE_DIR=/usr/local/lib
  POLICY_MODULE_NAME=hermesctl_policy
  WORKER_POLICY_MODULE_NAME=hermes_worker_policy
  WORKER_CONTROL_DIR=${HERMESCTL_WORKER_CONTROL_DIR:-/control/workers}
  CONTROL_CLI=/usr/local/bin/hermes-control
fi

export HERMES_HOST_ROOT="$ROOT_DIR"
export HERMES_UID="${HERMES_UID:-$(id -u)}"
export HERMES_GID="${HERMES_GID:-$(id -g)}"
# Separately selectable compose overlays make intentionally running workers
# look like orphans to commands that do not include that worker's overlay.
export COMPOSE_IGNORE_ORPHANS="${COMPOSE_IGNORE_ORPHANS:-true}"

BASE_COMPOSE=(docker compose --project-directory "$ROOT_DIR" -f "$ROOT_DIR/compose.yaml")
SANDBOX_COMPOSE=(-f "$ROOT_DIR/compose.sandbox.yaml")
CONTROL_COMPOSE=(-f "$ROOT_DIR/compose.control.yaml")
ORCHESTRATOR_COMPOSE=(-f "$ROOT_DIR/compose.orchestrator.yaml")
CLAUDE_CONTEXT_COMPOSE=(-f "$ROOT_DIR/compose.claude-context.yaml")
AGENTS_COMPOSE=(-f "$ROOT_DIR/compose.agents.yaml")
WORKER_KINDS=(codex claude opencode)
ALL_WORKER_COMPOSE=()
for worker_kind in "${WORKER_KINDS[@]}"; do
  ALL_WORKER_COMPOSE+=(-f "$ROOT_DIR/compose.worker-$worker_kind.yaml")
done

usage() {
  sed -n '2,80p' <<'EOF'
Usage: ./hermesctl COMMAND [ARGS]

Start:
  init                         Create isolated state/workspace (zero rights)
  build                        Build the thin image on official Hermes
  chat [Hermes chat args]      Interactive policy-enforced chat
  ask "prompt"                 One-shot policy-enforced request

Rights (independent switches):
  enable CAPABILITY [...]      Enable one or more capabilities
  disable CAPABILITY [...]     Disable one or more capabilities
  reset                        Disable every model-facing capability
  status                       Show the effective policy
  capabilities                 List available switches

Generic access (same user-facing switches for every target):
  access TARGET status         Show the target's effective access policy
  access TARGET explain        Show native/special mappings and alternatives
  access TARGET capabilities   List the five common access switches
  access TARGET enable FEATURE [...]
  access TARGET disable FEATURE [...]
  access TARGET reset          Reset only this target to its zero-right state

Access targets: hermes, codex, claude, opencode
Common features: tool-use, commandline, skills, agents-md, claude-md

Administration (operator actions, never agent tools):
  model [Hermes model args]    Choose provider/model with the official wizard
  anthropic-login [auth args]  Add an Anthropic OAuth account interactively
  auth [Hermes auth args]      Run the official Hermes auth command
  login-ui [UI args]           Local API/HTML UI for worker subscription login
  skills [Hermes skills args]  Install/list skills as the operator
  worker KIND ACTION [ARGS]    Build/login/configure a coding worker
  agent ACTION [ARGS]          Manage arbitrary isolated agent instances
  credential ACTION [ARGS]     Manage brokered per-instance CLI credentials
  team ACTION [ARGS]           Apply/run declarative multi-agent teams
  job ACTION [ARGS]            Submit/status/cancel persistent agent jobs
  artifact ACTION [ARGS]       Exchange immutable team handoff artifacts
  benchmark ACTION [ARGS]      Plan/run/export isolated agent evaluations
  verify                       Run tests, build, and print policy evidence

Worker actions:
  build                        Build this worker's pinned CLI image
  login [CLI login args]       Interactive account login (operator only)
  logout                       Remove this worker's stored login
  status                       Show version, model, and login state
  rights                       Show this worker's effective feature policy
  capabilities                 List the worker feature switches
  enable FEATURE [...]         Enable worker features for its next task
  disable FEATURE [...]        Disable worker features for its next task
  reset                        Return this worker to model-only operation
  model [MODEL|none]           Show, set, or clear the worker model
  start | stop                 Start or stop the isolated worker service
  run "prompt"                Operator test request through its Unix socket

Worker kinds: codex, claude, opencode

Generic agent quick start:
  agent create ID --engine KIND [--credential CREDENTIAL] [--role ROLE]
  agent grant ID inspect edit commandline network skills agents-md claude-md
  agent build|login|start|status|run|stop ID
  agent delete ID --yes [--delete-credential]
  agent model ID [MODEL|none]
  agent clone ID SOURCE [--branch BRANCH]
  agent patch ID ARTIFACT

Team quick start:
  team example                 Print a version-1 declarative manifest
  team apply team.yaml --explain
  team apply team.yaml
  team status|run|reset NAME

Benchmark quick start:
  benchmark example            Print a version-1 evaluation manifest
  benchmark plan FILE          Validate targets, variants, and rights
  benchmark create FILE        Snapshot inputs and create an experiment
  benchmark run ID [--wait]    Start or synchronously run the experiment
  benchmark status|cancel ID   Inspect or cancel persistent execution
  benchmark resume ID          Recover and continue interrupted execution
  benchmark export ID FILE     Export results including normalized outputs
  benchmark serve              Open the token-protected local dashboard

Granular agent rights:
  inspect, edit, commandline, network, skills, agents-md, claude-md
  edit requires inspect; commandline requires inspect + network.
  [special] Codex requires inspect+edit+commandline+network as one bundle.

Worker features (separate policy per worker):
  tools          built-in file/search tools; Codex maps this to read-only shell
  commandline    command execution and workspace writes (requires tools)
  skills         inject approved SKILL.md files from worker-context
  agents-md      inject the protected worker AGENTS.md
  claude-md      inject the protected worker CLAUDE.md

Capabilities:
  files          read/write/search only in runtime/workspace
  commandline    shell in a second hardened Docker container, no network
  skills         skill list/view/manage; no bundled skills; writes need approval
  web            Hermes web search/extract tools
  code           execute_code in the same command sandbox
  planning       in-session todo and clarify tools
  shell-network  network egress for commandline/code (separate modifier)
  orchestrator   load the opt-in AGENTS.md explainer/orchestrator context
  claude-md      load the opt-in protected CLAUDE.md context independently
  hermesctl-direct  let Hermes manage next-session rights through the CLI
                    (requires skills + commandline)
  hermesctl-mcp  let Hermes manage next-session rights through scoped MCP
                 (requires skills)
  codex-direct | claude-direct | opencode-direct
                 direct skill command through a private Unix socket
                 (each requires skills + commandline; no shell network)
  codex-mcp | claude-mcp | opencode-mcp
                 two scoped MCP tools for exactly one isolated worker
                 (each requires skills)
  agents-direct  generic list/status/run for registered agent instances
                 (requires skills + commandline)
  agents-mcp     generic agents/jobs/artifacts/teams MCP surface
                 (requires skills; credentials and login never exposed)

Aliases: tools=file(s), shell/terminal=commandline, agents-md=orchestrator
EOF
}

die() {
  printf 'hermesctl: %s\n' "$*" >&2
  exit 64
}

ensure_layout() {
  if [[ "$CONTROL_ONLY" == 1 ]]; then
    [[ -f "$CAPABILITIES_FILE" ]] || die 'capability control file is not mounted'
    local controlled_worker
    for controlled_worker in "${WORKER_KINDS[@]}"; do
      [[ -f "$WORKER_CONTROL_DIR/$controlled_worker/capabilities" ]] || \
        die "worker control file is not mounted: $controlled_worker"
    done
    [[ -d "$ROOT_DIR/runtime/control/agents" ]] || \
      die 'redacted agent control registry is not mounted'
    [[ -d "$ROOT_DIR/runtime/registry/agents" ]] || \
      die 'redacted agent policy registry is not mounted'
    return
  fi
  mkdir -p "$STATE_DIR" "$WORKSPACE_DIR" "$STATE_DIR/skills"
  mkdir -p \
    "$RUNTIME_DIR/control/agents" \
    "$RUNTIME_DIR/control/credentials" \
    "$RUNTIME_DIR/registry/agents" \
    "$RUNTIME_DIR/agents" \
    "$RUNTIME_DIR/credentials" \
    "$RUNTIME_DIR/sockets/agents" \
    "$RUNTIME_DIR/jobs" \
    "$RUNTIME_DIR/artifacts" \
    "$RUNTIME_DIR/teams" \
    "$RUNTIME_DIR/runs" \
    "$RUNTIME_DIR/evaluations" \
    "$RUNTIME_DIR/locks"
  chmod 700 \
    "$RUNTIME_DIR/control/agents" \
    "$RUNTIME_DIR/control/credentials" \
    "$RUNTIME_DIR/registry" \
    "$RUNTIME_DIR/registry/agents" \
    "$RUNTIME_DIR/agents" \
    "$RUNTIME_DIR/credentials" \
    "$RUNTIME_DIR/sockets" \
    "$RUNTIME_DIR/sockets/agents" \
    "$RUNTIME_DIR/jobs" \
    "$RUNTIME_DIR/artifacts" \
    "$RUNTIME_DIR/teams" \
    "$RUNTIME_DIR/runs" \
    "$RUNTIME_DIR/evaluations" \
    "$RUNTIME_DIR/locks"
  local worker
  for worker in "${WORKER_KINDS[@]}"; do
    mkdir -p \
      "$WORKER_CONTROL_DIR/$worker" \
      "$RUNTIME_DIR/workers/$worker/state" \
      "$RUNTIME_DIR/workers/$worker/workspace" \
      "$RUNTIME_DIR/workers/$worker/socket"
    if [[ ! -f "$RUNTIME_DIR/workers/$worker/workspace/.gitkeep" ]]; then
      : > "$RUNTIME_DIR/workers/$worker/workspace/.gitkeep"
    fi
    chmod 700 \
      "$WORKER_CONTROL_DIR/$worker" \
      "$RUNTIME_DIR/workers/$worker/state" \
      "$RUNTIME_DIR/workers/$worker/socket"
    chmod 750 "$RUNTIME_DIR/workers/$worker/workspace"
    if [[ ! -f "$WORKER_CONTROL_DIR/$worker/capabilities" ]]; then
      : > "$WORKER_CONTROL_DIR/$worker/capabilities"
    fi
    chmod 600 "$WORKER_CONTROL_DIR/$worker/capabilities"
  done
  chmod 700 "$RUNTIME_DIR/control" "$WORKER_CONTROL_DIR"
  mkdir -p \
    "$RUNTIME_DIR/workers/codex/state/.codex" \
    "$RUNTIME_DIR/workers/claude/state/.claude" \
    "$RUNTIME_DIR/workers/opencode/state/.local/share/opencode" \
    "$RUNTIME_DIR/workers/opencode/state/.config/opencode" \
    "$RUNTIME_DIR/workers/opencode/state/.cache/opencode"
  chmod 700 \
    "$RUNTIME_DIR/workers/codex/state/.codex" \
    "$RUNTIME_DIR/workers/claude/state/.claude" \
    "$RUNTIME_DIR/workers/opencode/state/.local" \
    "$RUNTIME_DIR/workers/opencode/state/.config" \
    "$RUNTIME_DIR/workers/opencode/state/.cache"
  if [[ ! -f "$STATE_DIR/config.yaml" ]]; then
    cp "$ROOT_DIR/config/config.yaml" "$STATE_DIR/config.yaml"
  fi
  if [[ ! -f "$STATE_DIR/.no-bundled-skills" ]]; then
    printf '%s\n' 'Bundled skill seeding disabled by hermes-naked.' > "$STATE_DIR/.no-bundled-skills"
  fi
  # The official image seeds SOUL.md when absent. An existing empty file plus
  # HERMES_IGNORE_RULES=1 guarantees that no custom identity is injected.
  if [[ ! -e "$STATE_DIR/SOUL.md" ]]; then
    : > "$STATE_DIR/SOUL.md"
  fi
  if [[ ! -f "$CAPABILITIES_FILE" ]]; then
    : > "$CAPABILITIES_FILE"
  fi
  if [[ -d "$PROJECT_SKILLS_DIR" ]]; then
    # These project-owned skills are installed but remain invisible to the
    # model until the independent `skills` capability is granted.
    cp -a "$PROJECT_SKILLS_DIR/." "$STATE_DIR/skills/"
  fi
  chmod 600 "$CAPABILITIES_FILE" "$STATE_DIR/.no-bundled-skills" "$STATE_DIR/SOUL.md"
}

worker_capabilities_file() {
  local worker=$1
  printf '%s\n' "$WORKER_CONTROL_DIR/$worker/capabilities"
}

raw_worker_features() {
  local worker=$1
  local feature_file
  feature_file=$(worker_capabilities_file "$worker")
  if [[ -f "$feature_file" ]]; then
    tr '\n' ',' < "$feature_file"
  fi
}

worker_policy_json() {
  local worker=$1
  local raw=${2-$(raw_worker_features "$worker")}
  python3 - "$worker" "$raw" "$POLICY_MODULE_DIR" "$WORKER_POLICY_MODULE_NAME" <<'PY'
import importlib
import json
import sys

worker, raw, module_dir, module_name = sys.argv[1:]
sys.path.insert(0, module_dir)
policy_module = importlib.import_module(module_name)
try:
    normalized_worker = policy_module.normalize_worker(worker)
    policy = policy_module.parse_worker_features(raw)
except policy_module.WorkerPolicyError as exc:
    print(f"hermesctl: {exc}", file=sys.stderr)
    raise SystemExit(64)

print(json.dumps({
    "worker": normalized_worker,
    "features": policy.features,
    "tools": policy.tools,
    "commandline": policy.commandline,
    "skills": policy.skills,
    "agents_md": policy.agents_md,
    "claude_md": policy.claude_md,
}))
PY
}

commit_worker_features() {
  local worker=$1
  local content=${2-}
  local feature_file feature_dir temporary
  feature_file=$(worker_capabilities_file "$worker")
  feature_dir=$(dirname "$feature_file")
  [[ -d "$feature_dir" ]] || die "worker control directory is unavailable: $worker"
  temporary=$(mktemp "$feature_dir/.capabilities.XXXXXX")
  if [[ -n "$content" ]]; then
    printf '%s\n' "$content" > "$temporary"
  fi
  chmod 600 "$temporary"
  mv "$temporary" "$feature_file"
}

write_worker_features() {
  local worker=$1
  local action=$2
  shift 2
  (($# > 0)) || die "worker $action needs at least one feature"
  local current normalized
  current=$(raw_worker_features "$worker")
  normalized=$(python3 - "$action" "$current" "$POLICY_MODULE_DIR" \
    "$WORKER_POLICY_MODULE_NAME" "$@" <<'PY'
import importlib
import sys

action, current, module_dir, module_name = sys.argv[1:5]
requested = sys.argv[5:]
sys.path.insert(0, module_dir)
policy_module = importlib.import_module(module_name)
try:
    current_values = set(policy_module.parse_worker_features(current).features)
    requested_values = {
        policy_module.normalize_worker_feature(value) for value in requested
    }
    if action == "enable":
        result = current_values | requested_values
    else:
        result = current_values - requested_values
    policy = policy_module.parse_worker_features(",".join(sorted(result)))
except policy_module.WorkerPolicyError as exc:
    print(f"hermesctl: {exc}", file=sys.stderr)
    raise SystemExit(64)
print("\n".join(policy.features))
PY
  )
  commit_worker_features "$worker" "$normalized"
}

show_worker_rights() {
  local worker=$1
  local json features
  json=$(worker_policy_json "$worker")
  features=$(policy_field features "$json")
  printf 'Worker rights:    %s\n' "${features:-none (model-only)}"
  printf 'Tools:            %s\n' "$(policy_field tools "$json")"
  printf 'Commandline:      %s\n' "$(policy_field commandline "$json")"
  printf 'Skills:           %s\n' "$(policy_field skills "$json")"
  printf 'AGENTS.md:        %s\n' "$(policy_field agents_md "$json")"
  printf 'CLAUDE.md:        %s\n' "$(policy_field claude_md "$json")"
  case "$worker" in
    codex)
      if [[ $(policy_field tools "$json") == false ]]; then
        printf 'Tools mapping:    Codex shell tool disabled\n'
      elif [[ $(policy_field commandline "$json") == true ]]; then
        printf 'Tools mapping:    Codex shell tool with workspace-write sandbox\n'
      else
        printf 'Tools mapping:    Codex shell tool in read-only sandbox\n'
      fi
      ;;
    claude)
      if [[ $(policy_field tools "$json") == false ]]; then
        printf 'Tools mapping:    all Claude built-in tools disabled\n'
      elif [[ $(policy_field commandline "$json") == true ]]; then
        printf 'Tools mapping:    Read, Glob, Grep, Edit, Write plus Bash\n'
      else
        printf 'Tools mapping:    Read, Glob, Grep, Edit, Write; Bash disabled\n'
      fi
      ;;
    opencode)
      if [[ $(policy_field tools "$json") == false ]]; then
        printf 'Tools mapping:    all OpenCode file and Bash permissions denied\n'
      elif [[ $(policy_field commandline "$json") == true ]]; then
        printf 'Tools mapping:    read, glob, grep, edit plus bash\n'
      else
        printf 'Tools mapping:    read, glob, grep, edit; bash denied\n'
      fi
      ;;
  esac
  printf 'Worker egress:    provider network exists independently of Hermes shell-network\n'
  printf 'Applies:          next task run by this worker\n'
}

